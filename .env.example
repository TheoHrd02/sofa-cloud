# ═══════════════════════════════════════════════════════════════════
#  SOFA-CLOUD — Variables d'Environnement
#  ⚠ Copier ce fichier en .env et NE JAMAIS committer .env sur Git
# ═══════════════════════════════════════════════════════════════════

# ─── ENVIRONNEMENT ───────────────────────────────────────────────
NODE_ENV=development
PYTHON_ENV=development

# ─── SHOPIFY ─────────────────────────────────────────────────────
# Storefront API : accès public (lecture produits, collections)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_API_TOKEN=your_storefront_public_token

# Admin API : accès privé (stocks, commandes, webhooks)
SHOPIFY_ADMIN_API_TOKEN=shpat_your_admin_token_here
SHOPIFY_API_VERSION=2025-01

# ─── POSTGRESQL ──────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=sofa_cloud
POSTGRES_USER=sofa_user
POSTGRES_PASSWORD=change_me_in_production_use_strong_password

# URL complète pour SQLAlchemy (async)
DATABASE_URL=postgresql+asyncpg://sofa_user:change_me_in_production_use_strong_password@db:5432/sofa_cloud

# ─── CLOUDINARY ──────────────────────────────────────────────────
# CDN pour images produits et vidéos hero
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# ─── FRONTEND (exposé côté client) ───────────────────────────────
PUBLIC_STORE_DOMAIN=${SHOPIFY_STORE_DOMAIN}
PUBLIC_STOREFRONT_API_TOKEN=${SHOPIFY_STOREFRONT_API_TOKEN}

# URL interne Docker du middleware (réseau sofa_network)
MIDDLEWARE_API_URL=http://middleware:8000

# ─── MIDDLEWARE ───────────────────────────────────────────────────
# Clé secrète pour JWT tokens (générer avec : openssl rand -hex 32)
SECRET_KEY=generate_a_64_char_random_hex_string_here

# Clé API interne (protège les endpoints d'écriture — sync fournisseur)
# Générer avec : openssl rand -hex 32
INTERNAL_API_KEY=generate_a_32_char_random_hex_string_here

# Origines autorisées pour CORS (séparées par virgule)
CORS_ORIGINS=http://localhost:3000,https://sofa-cloud.com

# ─── FOURNISSEURS (Automation Stocks/Prix) ────────────────────────
# Clé API du fournisseur principal
SUPPLIER_API_KEY=your_supplier_api_key
SUPPLIER_API_URL=https://api.your-supplier.com/v1

# Fréquence de synchronisation automatique (en heures)
SUPPLIER_SYNC_INTERVAL_HOURS=6

# ─── ANALYTIQUE ────────────────────────────────────────────────────
# Optional : Google Analytics 4, Hotjar, etc.
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
HOTJAR_ID=

# ─── NOTIFICATIONS ─────────────────────────────────────────────────
# Optional : Alertes Slack ou email pour erreurs critiques de sync
SLACK_WEBHOOK_URL=
ALERT_EMAIL=admin@sofa-cloud.com
